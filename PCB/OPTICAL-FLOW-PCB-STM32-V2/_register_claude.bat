@echo off
set "LOG=%~dp0_eda_agent_setup.log"
set "VPY=%USERPROFILE%\eda-agent\.venv\Scripts\python.exe"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=@(); $c+=Get-ChildItem \"$env:LOCALAPPDATA\Packages\" -Directory -Filter 'Claude*' -EA 0 | %% { Join-Path $_.FullName 'LocalCache\Roaming\Claude' }; $c+=\"$env:APPDATA\Claude\"; $c+=\"$env:LOCALAPPDATA\AnthropicClaude\"; Write-Host 'Candidates:'; $c | %% { Write-Host \"  $_  exists=$(Test-Path $_)\" }; $d=$c | ?{ Test-Path $_ } | select -First 1; if(-not $d){Write-Host 'NO CLAUDE CONFIG DIR FOUND'; exit 1}; $f=Join-Path $d 'claude_desktop_config.json'; Write-Host \"Using $f\"; if(Test-Path $f){Copy-Item $f \"$f.bak-edaagent\" -Force; $j=Get-Content $f -Raw | ConvertFrom-Json}else{$j=[pscustomobject]@{}}; if(-not $j.mcpServers){$j | Add-Member mcpServers ([pscustomobject]@{}) -Force}; $s=[pscustomobject]@{command=$env:VPY; args=@('-m','eda_agent','--headless'); env=[pscustomobject]@{EDA_AGENT_READONLY='1'; EDA_AGENT_TOOLSET='minimal'; EDA_AGENT_UI_AUTOMATION='0'; EDA_AGENT_UPDATE_CHECK='0'}}; $j.mcpServers | Add-Member altium $s -Force; [IO.File]::WriteAllText($f, ($j | ConvertTo-Json -Depth 20), (New-Object Text.UTF8Encoding $false)); Write-Host 'REGISTER OK'; Write-Host 'Servers now:' ($j.mcpServers.PSObject.Properties.Name -join ', ')" >> "%LOG%" 2>&1
